// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id               Int      @id @default(autoincrement())
  roomId           String   @map("room_id")
  date             String
  timeSlot         String   @map("time_slot")
  title            String?
  booker           String
  extension        String
  orderIndex       Int      @default(1) @map("order_index")
  recurringGroupId String?  @map("recurring_group_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("bookings")
  @@index([roomId, date])
  @@index([roomId, date, timeSlot])
  @@index([roomId, date, timeSlot, orderIndex])
  @@index([recurringGroupId])
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  quantity  Int      @default(0)
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}

model ItemRequest {
  id         Int      @id @default(autoincrement())
  extension  String
  department String   // 部門: BB, BC, BD, BF, BN, BI, BS
  items      String   // JSON: [{"itemId": 1, "name": "禮券", "quantity": 2}]
  reason     String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("item_requests")
  @@index([extension])
  @@index([department])
  @@index([createdAt])
}
